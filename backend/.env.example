# ─── API principal SmartCommerce (NestJS) ─────────────────────────────────────
# Copiar a .env y completar. NUNCA subir .env al repositorio (gitleaks lo bloquea).
# Generar secretos con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
APP_VERSION=0.1.0
PORT=3000
LOG_LEVEL=info
# Orígenes permitidos (Ionic dev, Angular dev, Nginx en Docker, Capacitor Android)
CORS_ORIGINS=http://localhost:8100,http://localhost:4200,http://localhost:8080,https://localhost
TRUST_PROXY=false
SWAGGER_ENABLED=true
THROTTLE_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# PostgreSQL — la API usa el rol con permisos mínimos (solo DML)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcommerce
DB_USER=smartcommerce_app
DB_PASSWORD=reemplazar-clave-app
DB_SSL=false
DB_POOL_MAX=10
# Rol propietario usado SOLO por `npm run migration:run` / contenedor migrate
DB_MIGRATION_USER=smartcommerce_owner
DB_MIGRATION_PASSWORD=reemplazar-clave-owner

# Autenticación
JWT_ACCESS_SECRET=reemplazar-por-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Servicio SmartMatch (Python/FastAPI) en la red interna
PYTHON_SERVICE_URL=http://localhost:8000
INTERNAL_API_TOKEN=reemplazar-por-el-mismo-token-configurado-en-python-service
SMARTMATCH_TIMEOUT_MS=5000
SMARTMATCH_INGESTION_TIMEOUT_MS=30000
SMARTMATCH_MAX_RETRIES=2
SMARTMATCH_BREAKER_THRESHOLD=5
SMARTMATCH_BREAKER_OPEN_MS=30000
