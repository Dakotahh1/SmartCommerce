    "/api/v1/products": {
      "get": {
        "operationId": "ProductsController_search_v1",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "integer"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Texto a buscar en nombre y marca",
            "schema": {
              "maxLength": 100,
              "pattern": "^[^\\p{Cc}\\uFFFD]*$",
              "example": "avena",
              "type": "string"
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Slug de categoría",
            "schema": {
              "pattern": "^[a-z0-9:-]{2,120}$",
              "example": "breakfast-cereals",
              "type": "string"
            }
          },
          {
            "name": "nutriscore",
            "required": false,
            "in": "query",
            "description": "Nutri-Score permitidos (csv)",
            "schema": {
              "maxItems": 5,
              "example": "a,b",
              "type": "string",
              "items": {
                "type": "string",
                "enum": [
                  "a",
                  "b",
                  "c",
                  "d",
                  "e"
                ]
              }
            }
          },
          {
            "name": "maxNova",
            "required": false,
            "in": "query",
            "description": "Grupo NOVA máximo",
            "schema": {
              "minimum": 1,
              "maximum": 4,
              "type": "number"
            }
          },
          {
            "name": "excludeAllergens",
            "required": false,
            "in": "query",
            "description": "Alérgenos a excluir (csv)",
            "schema": {
              "maxItems": 14,
              "example": "gluten,milk",
              "type": "string",
              "items": {
                "type": "string",
                "enum": [
                  "gluten",
                  "milk",
                  "eggs",
                  "tree_nuts",
                  "peanuts",
                  "soy",
                  "fish",
                  "crustaceans",
                  "celery",
                  "mustard",
                  "sesame",
                  "sulphites",
                  "lupin",
                  "molluscs"
                ]
              }
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "Orden de resultados. Por defecto `relevance` si hay texto (`q`) y `quality` si no.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "quality",
                "name",
                "recent"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de productos normalizados con filtros y búsqueda"
          }
        },
        "tags": [
          "catálogo"
        ]
      }
    },
