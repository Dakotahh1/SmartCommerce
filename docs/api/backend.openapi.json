  "info": {
    "title": "SmartCommerce API",
    "description": "API REST principal. Autenticación con JWT (Bearer) y refresh token rotativo. Todas las respuestas de error siguen el formato {statusCode, code, message, details, path, timestamp, requestId}.",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "camila@correo.cl"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d).+$",
            "example": "Clave-segura-2026"
          },
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "pattern": "^[^<>]*$",
            "example": "Camila Vergara"
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "enum": [
              "admin",
              "operator",
              "user"
            ],
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "createdAt"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserProfileDto"
          },
          "accessToken": {
            "type": "string",
            "description": "JWT de corta duración"
          },
          "refreshToken": {
            "type": "string",
            "description": "Token opaco rotativo"
          },
          "tokenType": {
            "enum": [
              "Bearer"
            ],
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "description": "Segundos hasta que expira el access token",
            "example": 900
          }
        },
        "required": [
          "user",
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "camila@correo.cl"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "example": "Clave-segura-2026"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 128,
            "description": "Refresh token opaco recibido al iniciar sesión"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "DeleteAccountDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128,
            "description": "Contraseña actual para confirmar la eliminación"
          }
        },
        "required": [
          "password"
        ]
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "operator",
              "user"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "WeightsDto": {
        "type": "object",
        "properties": {
          "nutrition": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "example": 30
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "example": 25
          },
          "processing": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "example": 20
          },
          "environment": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "example": 15
          },
          "availability": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "example": 10
          }
        },
        "required": [
          "nutrition",
          "price",
          "processing",
          "environment",
          "availability"
        ]
      },
      "UpdatePreferencesDto": {
        "type": "object",
        "properties": {
          "weights": {
            "$ref": "#/components/schemas/WeightsDto"
          },
          "diets": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 4,
            "items": {
              "type": "string",
              "enum": [
                "vegan",
                "vegetarian",
                "gluten_free",
                "lactose_free"
              ]
            },
            "example": [
              "gluten_free"
            ]
          },
          "excludedAllergens": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 14,
            "items": {
              "type": "string",
              "enum": [
                "gluten",
                "milk",
                "eggs",
                "tree_nuts",
                "peanuts",
                "soy",
                "fish",
                "crustaceans",
                "celery",
                "mustard",
                "sesame",
                "sulphites",
                "lupin",
                "molluscs"
              ]
            },
            "example": [
              "peanuts"
            ]
          },
          "avoidHighIn": {
            "type": "boolean",
            "description": "Excluir productos con sellos ALTO EN (Ley 20.606)"
          },
          "preferredStores": {
            "uniqueItems": true,
            "maxItems": 20,
            "example": [
              "lider",
              "jumbo"
            ],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]{2,60}$"
            }
          },
          "personalizationEnabled": {
            "type": "boolean",
            "description": "Si es false se usa la versión base no adaptativa"
          }
        },
        "required": [
          "weights",
          "diets",
          "excludedAllergens",
          "avoidHighIn",
          "preferredStores",
          "personalizationEnabled"
        ]
      },
      "StartIngestionDto": {
        "type": "object",
        "properties": {
          "country": {
            "type": "object",
            "default": "chile",
            "pattern": "^[a-z][a-z-]{1,39}$",
            "description": "Etiqueta de país en Open Food Facts"
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:-]{1,79}$",
            "example": "breakfast-cereals"
          },
          "brand": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:-]{1,79}$",
            "example": "quaker"
          },
          "page": {
            "type": "object",
            "default": 1,
            "minimum": 1,
            "maximum": 1000
          },
          "pageSize": {
            "type": "object",
            "default": 50,
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "InteractionContextDto": {
        "type": "object",
        "properties": {
          "screen": {
            "type": "string",
            "enum": [
              "home",
              "explore",
              "detail",
              "compare",
              "favorites"
            ]
          },
          "position": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000,
            "description": "Posición en la lista (para evaluar ranking)"
          }
        }
      },
      "CreateInteractionDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "enum": [
              "view",
              "favorite",
              "unfavorite",
              "compare",
              "dismiss",
              "recommendation_click",
              "recommendation_accept",
              "recommendation_reject"
            ],
            "type": "string"
          },
          "context": {
            "$ref": "#/components/schemas/InteractionContextDto"
          }
        },
        "required": [
          "productId",
          "type"
        ]
      },
      "CompareProductsDto": {
        "type": "object",
        "properties": {
          "productIds": {
            "uniqueItems": true,
            "minItems": 2,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "productIds"
        ]
      }
    }
  }
}
