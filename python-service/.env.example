# ─── Servicio SmartMatch (Python/FastAPI) ─────────────────────────────────────
# Copiar a .env y reemplazar valores. NUNCA subir .env al repositorio.

# development | test | staging | production (en production se desactiva /docs)
APP_ENV=development
LOG_LEVEL=INFO

# Secreto compartido con NestJS (mínimo 32 caracteres). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_TOKEN=reemplazar-por-un-token-aleatorio-de-al-menos-32-caracteres

# Fuente web: Open Food Facts (API oficial v2)
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=SmartCommerce/0.1.0 (contacto: equipo@smartcommerce.example)
OFF_TIMEOUT_SECONDS=10
OFF_MAX_RETRIES=2
OFF_SEARCH_RATE_PER_MINUTE=8
OFF_CACHE_TTL_SECONDS=300

# Protección de carga
MAX_CANDIDATES=200
