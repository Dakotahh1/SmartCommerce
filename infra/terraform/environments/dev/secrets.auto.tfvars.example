# Copiar a secrets.auto.tfvars (ignorado por git) SOLO para pruebas locales.
# En CI y en staging los secretos llegan como variables de entorno TF_VAR_<nombre> desde GitHub Secrets.
postgres_superuser_password = "cambiar-clave-superusuario"
db_owner_password           = "cambiar-clave-owner"
db_app_password             = "cambiar-clave-app"
jwt_access_secret           = "cambiar-secreto-jwt"
internal_api_token          = "cambiar-token-interno"
