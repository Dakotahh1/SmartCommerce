{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "catalogo-lectura",
      "urls": ["/api/v1/products", "/api/v1/products/**", "/api/v1/categories"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 100, "maxAge": "1d", "timeout": "4s" }
    },
    {
      "name": "imagenes-productos",
      "urls": ["https://images.openfoodfacts.org/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 200, "maxAge": "7d" }
    }
  ],
  "navigationUrls": ["/**", "!/api/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**"]
}
