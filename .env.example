# ──────────────────────────────────────────────────────────────────────────────
# SmartCommerce · variables para Docker Compose (raíz del repositorio)
#
#   scripts/init-env.sh      → crea .env reemplazando cada "cambiar-..." por un valor aleatorio
#   (o copiar a .env y completar a mano)
#
# .env está en .gitignore y gitleaks bloquea el push si se versiona un secreto.
# En GitHub Actions: SECRETOS → Settings › Secrets and variables › Actions › Secrets
#                    NO SENSIBLES → … › Variables  (detalle en docs/08-variables-y-secretos.md)
# ──────────────────────────────────────────────────────────────────────────────

# ── Generales (no sensibles) ─────────────────────────────────────────────────
# development | test | staging | production  (production desactiva /docs en FastAPI)
APP_ENV=staging
APP_VERSION=0.1.0
LOG_LEVEL=info
PYTHON_LOG_LEVEL=INFO
# Imágenes: local → smartcommerce-<servicio>:local · CI/staging → ghcr.io/<owner>/smartcommerce-<servicio>:<sha>
IMAGE_PREFIX=smartcommerce
IMAGE_TAG=local

# ── Gateway web (no sensibles) ───────────────────────────────────────────────
# 127.0.0.1 publica la app solo en esta máquina; usar 0.0.0.0 para exponerla en la red.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:8080,https://localhost
SWAGGER_ENABLED=true
THROTTLE_ENABLED=true
THROTTLE_LIMIT=120

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=smartcommerce
POSTGRES_SUPERUSER=postgres
# SECRETO: solo para inicializar el contenedor (ningún servicio de la app lo usa)
POSTGRES_SUPERUSER_PASSWORD=cambiar-clave-superusuario
# Rol dueño del esquema: solo el contenedor one-shot `migrate` (DDL)
DB_OWNER_USER=smartcommerce_owner
# SECRETO
DB_OWNER_PASSWORD=cambiar-clave-owner
# Rol de la API: solo SELECT/INSERT/UPDATE/DELETE
DB_APP_USER=smartcommerce_app
# SECRETO
DB_APP_PASSWORD=cambiar-clave-app
DB_POOL_MAX=10

# ── Autenticación ────────────────────────────────────────────────────────────
# SECRETO (≥ 32 caracteres): firma de los JWT de acceso
JWT_ACCESS_SECRET=cambiar-secreto-jwt
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# ── Comunicación NestJS → FastAPI ────────────────────────────────────────────
# SECRETO (≥ 32 caracteres): token compartido entre servicios (header X-Internal-Token)
INTERNAL_API_TOKEN=cambiar-token-interno
SMARTMATCH_TIMEOUT_MS=5000
SMARTMATCH_INGESTION_TIMEOUT_MS=45000

# ── Fuente web: Open Food Facts (no sensibles) ───────────────────────────────
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=SmartCommerce/0.1.0 (contacto: equipo@smartcommerce.example)
OFF_TIMEOUT_SECONDS=10
OFF_SEARCH_RATE_PER_MINUTE=8
OFF_CACHE_TTL_SECONDS=300
